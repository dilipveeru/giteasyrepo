#!/usr/bin/env python3
"""Basic Python example script.

Features:
- prints a greeting
- simple add function with demonstration
"""

def add(a, b):
	"""Return the sum of a and b."""
	return a + b


def main():
	print("Hello from basic Python script!")
	x, y = 3, 5
	print(f"{x} + {y} = {add(x, y)}")


if __name__ == "__main__":
	main()
